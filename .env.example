# Copia este archivo a .env.local y rellena con los valores reales
# (Supabase → Settings → API). La clave es la "publishable"/"anon" — la
# que empieza por sb_publishable_ o es un JWT. Nunca la "secret"/"service_role":
# esa se salta las políticas de RLS y da acceso total a la base de datos.
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
